{
  "name": "@gespenst/docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:content": "pnpm --dir ../.. --filter @gespenst/core build && pnpm --dir ../.. --filter @gespenst/wasmer build && pnpm --dir ../.. docs:prepare",
    "predev": "pnpm run prepare:content",
    "dev": "node ../../scripts/vite-dev.mjs",
    "prebuild": "pnpm run prepare:content",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gespenst/clipboard": "workspace:*",
    "@gespenst/core": "workspace:*",
    "@gespenst/themes": "workspace:*",
    "@gespenst/wasmer": "workspace:*",
    "@wasmer/sdk": "0.10.0",
    "coi-serviceworker": "0.1.7"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
