# Cloudflare Pages reads this file from the deployment root.
#
# Security defaults and immutable caching for the static documentation deployment.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite fingerprints these filenames, so a given URL can never change contents.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
