{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node", "vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@gespenst/clipboard": ["./packages/clipboard/src/index.ts"],
      "@gespenst/core": ["./packages/core/src/index.ts"],
      "@gespenst/core/headless": ["./packages/core/src/core/index.ts"],
      "@gespenst/themes": ["./packages/themes/src/index.ts"],
      "@gespenst/xterm": ["./packages/xterm/src/index.ts"]
    },
    "noEmit": true
  },
  "include": [
    "demo/**/*.ts",
    "examples/**/*.ts",
    "packages/**/*.ts",
    "apps/**/*.ts",
    "benchmarks/**/*.ts",
    "vite.workspace.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "vitest.browser.compat.config.ts"
  ],
  "exclude": ["**/dist/**", "node_modules", "external-projects"]
}
