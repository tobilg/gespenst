{
  "name": "@gespenst/xterm",
  "version": "0.1.1",
  "description": "xterm.js 6.0 public API compatibility powered by Ghostty",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/gespenst.git",
    "directory": "packages/xterm"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css/xterm.css": "./dist/xterm.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/xterm.css"
  ],
  "dependencies": {
    "@gespenst/core": "workspace:^"
  },
  "devDependencies": {
    "@xterm/addon-attach": "0.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && node ../../scripts/build-xterm-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
