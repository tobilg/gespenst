{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@gespenst/bashkit": ["../bashkit/dist/index.d.ts"],
      "@gespenst/core": ["../core/dist/index.d.ts"]
    },
    "rootDir": "src",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"]
}
