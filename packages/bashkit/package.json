{
  "name": "@gespenst/bashkit",
  "version": "0.1.2",
  "description": "Single-process browser Bash addon for gespenst powered by BashKit",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobilg/gespenst.git",
    "directory": "packages/bashkit"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@gespenst/core": "^0.1.2"
  },
  "dependencies": {
    "@everruns/bashkit-wasm": "0.17.1"
  },
  "devDependencies": {
    "@gespenst/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
