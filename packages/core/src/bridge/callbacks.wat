  (type $mime_reader (func (param i32 i32 i32) (result i32)))

  (import "host" "write_pty" (func $write_pty (type $terminal_write)))
  (import "host" "bell" (func $bell (type $terminal_event)))
  (import "host" "title_changed" (func $title_changed (type $terminal_event)))
  (import "host" "pwd_changed" (func $pwd_changed (type $terminal_event)))
  (import "host" "desktop_notification" (func $desktop_notification (type $terminal_pointer_event)))
  (import "host" "progress_report" (func $progress_report (type $terminal_pointer_event)))
  (import "host" "clipboard_read" (func $clipboard_read (type $terminal_pointer_event)))
