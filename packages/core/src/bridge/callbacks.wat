  (import "host" "mime_reader" (func $mime_reader (type $mime_reader)))
  (import "host" "random_secure" (func $random_secure (type $secure_random)))
  (import "host" "color_scheme" (func $color_scheme (type $terminal_result_event)))

  (export "write_pty" (func $write_pty))
  (export "bell" (func $bell))
  (export "title_changed" (func $title_changed))
  (export "pwd_changed" (func $pwd_changed))
  (export "desktop_notification" (func $desktop_notification))
