  (export "clipboard_read" (func $clipboard_read))
  (export "clipboard_write" (func $clipboard_write))
  (export "mime_reader" (func $mime_reader))
  (export "random_secure" (func $random_secure))
  (export "color_scheme" (func $color_scheme))
)
